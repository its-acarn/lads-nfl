  "//notInLeague": "Names on the sheet that Sleeper's player map does not contain at all -- unsigned, retired, or otherwise not on an NFL roster. Dropped at import and reported on every run, so the list stays honest rather than quietly growing. If one of these signs, delete them from here and re-import.",
  "notInLeague": [],

  "rules": {
    "//maxByPos": "Hard cap per position. One QB, one TE, no kicker, no defense (Andrew, Aug 2026). RB/WR left permissive so the board drives them rather than the cap. A position capped at 0 also loses its starter slot in the lineup, so forced mode can never demand one.",
    "maxByPos": { "QB": 1, "RB": 8, "WR": 8, "TE": 1, "K": 0, "DEF": 0 },

    "//maxPerNflTeamByPos": "How many players from the same NFL team may be held at a position. RB 1 = never two backs out of one backfield: they split the touches that make either worth owning, and the injury that hands one the job removes the other (Andrew, Aug 2026, after the 2026-08-17 mock came out holding Irving+Gainwell and Pollard+Spears). Deliberately RB only -- two receivers on one offence are a much weaker correlation, and that same mock's Godwin-with-Irving drew no objection. Softer than a position cap: if it is the only thing standing between the engine and no legal pick it is given up first, and announced.",
    "maxPerNflTeamByPos": { "RB": 1 },

    "//minCountByRound": "At least `count` players at this position by the END of `byRound` -- that round is INCLUDED. RB 3 by round 5 = three running backs inside the first five rounds (Andrew, Aug 2026; tightened from round 6 after the 2026-08-27 mock, where a round-6 deadline let a fourth receiver go at pick 44). WR 2 by round 5 added 2026-08-31: together the two quotas claim all five window picks from slot 5, so any non-RB/WR pick in rounds 1-5 leaves one of them unpayable. Each quota binds on its own arithmetic; there is no joint check (see the draft-night-delivery ExecPlan). The inverse of minRoundByPos: a floor is a prohibition, which can always be met by taking somebody else, while this is an obligation that eventually has to be paid. It binds JUST IN TIME -- while enough of your picks remain inside the window to settle it later the board decides as normal, and only when the players still owed equal the picks left in the window does the candidate set narrow. From slot 5 the window is picks 5, 20, 29, 44 and 53, so the earliest it can bind is pick 29, and it never binds at all if you take backs early. If it can no longer be met -- more owed than picks left -- it stands down and says so rather than blocking the draft, because unlike a floor it is a claim about picks already spent. It is the LAST rule the relaxation ladder gives up.",
    "minCountByRound": { "RB": { "count": 3, "byRound": 5 }, "WR": { "count": 2, "byRound": 5 } },

    "//minRoundByPos": "Earliest round each position may be drafted. Omit a position for no floor. ABSOLUTE: nothing overrides a floor -- not scarcity, not forced mode, not the relaxation ladder. QB 12 encodes streaming quarterbacks, which is a strategy and not a workaround, so the only way past a floor is to change it here. If a floor ever leaves no legal pick the bot says so loudly rather than breaching it.",
    "minRoundByPos": { "QB": 12, "K": 13, "DEF": 12 },

    "//vonaFromRound": "Rounds below this follow the board's order outright; from it, positional scarcity takes over. Set it above the number of rounds to disable scarcity entirely.",
    "vonaFromRound": 9,

    "//stashRound": "Before this round, players designated Out/IR/PUP/Sus/COV/DNR/NA are excluded. From it they become draftable as stashes.",
    "stashRound": 12,

    "//offBoardDiscount": "Value multiplier for anyone not on the board, after interpolating their ADP onto its curve. Lower keeps the bot closer to the list.",
    "offBoardDiscount": 0.8,

    "//value": "The board value curve. tierDecay is the big one: each tier is worth this much of the one above, so lower makes tiers dominant and higher flattens the board toward one long list. rankEpsilon is the weight of ordering WITHIN a tier -- raising it far enough to beat positional scarcity would invert the tiers, so use vonaFromRound for that instead. These are the engine defaults, spelled out so they are visible.",
    "value": { "tierBase": 100, "tierDecay": 0.85, "rankEpsilon": 0.01 },

    "//useRosterNeed": "false = a pick is judged on board value and scarcity alone. Position still matters through maxByPos and minRoundByPos, but a starter-shaped hole no longer outscores bench depth.",
    "useRosterNeed": false,

    "//useForcedStarters": "false = never collapse the candidate set to unfilled starter slots near the end. The board and scarcity decide to the last pick, which means a required slot can go unfilled and be covered off waivers.",
    "useForcedStarters": true,

    "//needWeights": "How hard the bot chases a roster hole. starter is an unfilled dedicated slot, flex an open flex slot, benchDecay pure depth indexed by how many spares are already held, benchFloor everything past that. Lowering starter makes it less willing to reach for a position just because the slot is empty. Engine defaults, spelled out.",
    "needWeights": { "starter": 1.0, "flex": 0.75, "benchDecay": [0.5, 0.35, 0.2], "benchFloor": 0.1 }
  }
